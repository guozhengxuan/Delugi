index 0000000..50ab285
--- /dev/null
+++ b/crates/delugi-benchmark-observer/src/admission.rs
@@ -0,0 +1,105 @@
+//! Read-only, run-bound admission bits supplied by the origin application.
+use std::{
+    fs::File,
+    io::{self, Read},
+    os::{
+        fd::AsRawFd,
+        raw::{c_int, c_void},
+    },
+    path::Path,
+    sync::atomic::{AtomicU8, Ordering},
+};
+extern "C" {
+    fn mmap(
+        address: *mut c_void,
+        length: usize,
+        protection: c_int,
+        flags: c_int,
+        fd: c_int,
+        offset: i64,
+    ) -> *mut c_void;
+    fn munmap(address: *mut c_void, length: usize) -> c_int;
+}
+/// A fixed-size shared admission map. The controller never truncates it.
+pub struct Admission {
+    address: usize,
+    length: usize,
+    header: usize,
+    count: usize,
+}
+impl Admission {
+    /// Verify the immutable run/plan/origin header before mapping its bitset.
+    pub fn open(path: &Path, expected: &[u8], count: usize) -> io::Result<Self> {
+        let mut file = File::open(path)?;
+        let length = expected.len() + (count + 7) / 8;
+        if file.metadata()?.len() != length as u64 {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "admission map size",
+            ));
+        }
+        let mut header = vec![0; expected.len()];
+        file.read_exact(&mut header)?;
+        if header != expected {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "admission map identity",
+            ));
+        }
+        let address = unsafe { mmap(std::ptr::null_mut(), length, 1, 1, file.as_raw_fd(), 0) };
+        if address as isize == -1 {
+            return Err(io::Error::last_os_error());
+        }
+        Ok(Self {
+            address: address as usize,
+            length,
+            header: expected.len(),
+            count,
+        })
+    }
+
+    /// Observe one origin-admission bit without per-output filesystem calls.
+    pub fn contains(&self, sequence: usize) -> bool {
+        if sequence >= self.count {
+            return false;
+        }
+        let pointer = (self.address + self.header + sequence / 8) as *const AtomicU8;
+        // One controller thread publishes aligned byte-sized bit updates before
+        // sending the request. This mapping is read-only in native validators.
+        (unsafe { (*pointer).load(Ordering::Acquire) }) & (1 << (sequence % 8)) != 0
+    }
+}
+impl Drop for Admission {
+    fn drop(&mut self) {
+        unsafe { munmap(self.address as *mut c_void, self.length) };
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::io::{Seek, SeekFrom, Write};
+    #[test]
+    fn maps_only_bound_origin_and_observes_publication() {
+        let path =
+            std::env::temp_dir().join(format!("shoal-admission-test-{}", std::process::id()));
+        let header = b"bound-run-origin-plan";
+        let mut file = std::fs::OpenOptions::new()
+            .create_new(true)
+            .write(true)
+            .open(&path)
+            .unwrap();
+        file.write_all(header).unwrap();
+        file.write_all(&[0]).unwrap();
+        assert!(Admission::open(&path, b"different-run-origin", 8).is_err());
+        let admission = Admission::open(&path, header, 8).unwrap();
+        assert!(!admission.contains(3));
+        file.seek(SeekFrom::Start(header.len() as u64)).unwrap();
+        file.write_all(&[8]).unwrap();
+        assert!(admission.contains(3));
+        assert!(!admission.contains(8));
+        drop(admission);
+        drop(file);
+        std::fs::remove_file(path).unwrap();
+    }
+}
diff --git a/crates/delugi-benchmark-observer/src/cpu.rs b/crates/delugi-benchmark-observer/src/cpu.rs
new file mode 100644
index 0000000..d855fb3
--- /dev/null
+++ b/crates/delugi-benchmark-observer/src/cpu.rs
@@ -0,0 +1,50 @@
+// Copied verbatim into each instrumented native crypto module. Disabled unless
+// BENCHMARK_CPU_PATH is set. Synchronous guards never cross an await point.
+use std::{fs, io::Write, os::raw::{c_int, c_long}, path::PathBuf,
+    sync::{OnceLock, atomic::{AtomicU64, Ordering}}, time::Duration};
+
+#[repr(C)] struct Timespec { tv_sec: c_long, tv_nsec: c_long }
+extern "C" { fn clock_gettime(id: c_int, time: *mut Timespec) -> c_int; }
+#[cfg(target_os = "linux")] const THREAD_CLOCK: c_int = 3;
+#[cfg(target_os = "macos")] const THREAD_CLOCK: c_int = 16;
+#[cfg(target_os = "linux")] const MONOTONIC_CLOCK: c_int = 1;
+#[cfg(target_os = "macos")] const MONOTONIC_CLOCK: c_int = 6;
+fn clock(id: c_int) -> u64 {
+    let mut ts = Timespec { tv_sec: 0, tv_nsec: 0 };
+    assert_eq!(unsafe { clock_gettime(id, &mut ts) }, 0, "benchmark CPU clock unavailable");
+    ts.tv_sec as u64 * 1_000_000_000 + ts.tv_nsec as u64
+}
+static COUNT: [AtomicU64; 4] = [AtomicU64::new(0),AtomicU64::new(0),AtomicU64::new(0),AtomicU64::new(0)];
+static CPU: [AtomicU64; 4] = [AtomicU64::new(0),AtomicU64::new(0),AtomicU64::new(0),AtomicU64::new(0)];
+static CONFIG: OnceLock<Option<PathBuf>> = OnceLock::new();
+
+fn enabled() -> bool {
+    CONFIG.get_or_init(|| {
+        let path = std::env::var_os("BENCHMARK_CPU_PATH").map(PathBuf::from)?;
+        let output = path.clone();
+        std::thread::Builder::new().name("native-crypto-observer".into()).spawn(move || loop {
+            let names = ["ordinary_sign", "ordinary_verify", "ordinary_verify_batch", "ordinary_verify_batch_multi"];
+            let fields: Vec<String> = names.iter().enumerate().map(|(i,name)| format!(
+                "\"{}\":{{\"calls\":{},\"thread_cpu_ns\":{}}}", name,
+                COUNT[i].load(Ordering::Relaxed), CPU[i].load(Ordering::Relaxed))).collect();
+            let row = format!("{{\"schema\":1,\"monotonic_ns\":{},\"scope\":\"native synchronous ordinary protocol authentication; hashing and input decoding included; elapsed thread CPU, not wall time; failed attempts charged\",\"operations\":{{{}}}}}\n", clock(MONOTONIC_CLOCK), fields.join(","));
+            let temporary = output.with_extension("tmp");
+            let mut file = fs::File::create(&temporary).expect("create native CPU snapshot");
+            file.write_all(row.as_bytes()).expect("write native CPU snapshot");
+            fs::rename(temporary, &output).expect("publish native CPU snapshot");
+            std::thread::sleep(Duration::from_millis(20));
+        }).expect("start native crypto observer");
+        Some(path)
+    }).is_some()
+}
+
+pub struct Guard { kind: usize, start_ns: u64 }
+pub fn begin(kind: usize) -> Option<Guard> {
+    if enabled() { Some(Guard { kind, start_ns: clock(THREAD_CLOCK) }) } else { None }
+}
+impl Drop for Guard {
+    fn drop(&mut self) {
+        CPU[self.kind].fetch_add(clock(THREAD_CLOCK).saturating_sub(self.start_ns), Ordering::Relaxed);
+        COUNT[self.kind].fetch_add(1, Ordering::Relaxed);
+    }
+}
