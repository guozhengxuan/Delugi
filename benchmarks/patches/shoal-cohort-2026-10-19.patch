@@ -0,0 +1,69 @@
+// Native paper-shoal fixture generation. This uses the published genesis builder;
+// it does not alter consensus, leader election, execution, or validator keys.
+use anyhow::{ensure, Context, Result};
+use aptos_genesis::builder::Builder;
+use aptos_types::on_chain_config::{
+    BlockGasLimitType, ConsensusAlgorithmConfig, DagConsensusConfigV1,
+    OnChainConsensusConfig, OnChainExecutionConfig, TransactionDeduperType,
+    TransactionShufflerType, ValidatorTxnConfig,
+};
+use rand::{rngs::{OsRng, StdRng}, RngCore, SeedableRng};
+use std::{fs, num::NonZeroUsize, path::PathBuf, sync::Arc};
+
+fn main() -> Result<()> {
+    let args: Vec<String> = std::env::args().collect();
+    if args.get(1).map(String::as_str)==Some("workload") {
+        ensure!(args.len()==7,"usage: shoal-fixture workload NEW_PLAN RUN_HEX ORIGIN COUNT USEFUL_BYTES");
+        return aptos_types::benchmark_cohort::write_workload(PathBuf::from(&args[2]).as_path(), &args[3],args[4].parse()?,args[5].parse()?,args[6].parse()?);
+    }
+    ensure!(args.len() == 6, "usage: shoal-fixture NEW_DIRECTORY NODES BATCH_BYTES BATCH_MS BOUND_MS");
+    let directory = PathBuf::from(&args[1]);
+    ensure!(!directory.exists(), "fixture directory already exists");
+    let nodes: usize = args[2].parse()?;
+    ensure!(nodes >= 4 && nodes <= 31 && (nodes - 1) % 3 == 0, "expected n=3f+1, 4..31");
+    let batch_bytes: u64 = args[3].parse()?;
+    let batch_ms: u64 = args[4].parse()?;
+    let bound_ms: u64 = args[5].parse()?;
+    ensure!(batch_bytes > 0 && batch_ms > 0 && bound_ms > 0, "settings must be positive");
+    fs::create_dir_all(&directory)?;
+    let consensus_config = OnChainConsensusConfig::V3 {
+        alg: ConsensusAlgorithmConfig::DAG(DagConsensusConfigV1::default()),
+        vtxn: ValidatorTxnConfig::default_disabled(),
+    };
+    fs::write(directory.join("on-chain-consensus.yaml"), serde_yaml::to_string(&consensus_config)?)?;
+    let mut seed = [0u8; 32];
+    OsRng.fill_bytes(&mut seed);
+    let builder = Builder::new(&directory, aptos_cached_packages::head_release_bundle().clone())?
+        .with_num_validators(NonZeroUsize::new(nodes).unwrap())
+        .with_init_genesis_config(Some(Arc::new(move |genesis| {
+            genesis.consensus_config = consensus_config.clone();
+            genesis.epoch_duration_secs = 24 * 3600;
+            match &mut genesis.execution_config {
+                OnChainExecutionConfig::V4(config) => {
+                    config.block_gas_limit_type = BlockGasLimitType::NoLimit;
+                    config.transaction_shuffler_type = TransactionShufflerType::NoShuffling;
+                    config.transaction_deduper_type = TransactionDeduperType::NoDedup;
+                }
+                _ => panic!("pinned native execution config changed"),
+            }
+        })))
+        .with_init_config(Some(Arc::new(move |_, config, _| {
+            let dag = &mut config.dag_consensus;
+            dag.node_payload_config.max_sending_size_per_round_bytes = batch_bytes;
+            dag.node_payload_config.max_receiving_size_per_round_bytes = batch_bytes;
+            dag.node_payload_config.payload_pull_max_poll_time_ms = batch_ms;
+            dag.rb_config.rpc_timeout_ms = bound_ms;
+            dag.fetcher_config.rpc_timeout_ms = bound_ms;
+            dag.fetcher_config.retry_interval_ms = bound_ms;
+            // Native reputation and three-DAG weak-vote rules retain their defaults.
+        })));
+    let (_, _, waypoint, validators) = builder.build(StdRng::from_seed(seed))
+        .context("native genesis ceremony failed")?;
+    fs::write(directory.join("waypoint.txt"), waypoint.to_string())?;
+    for validator in validators {
+        let config = validator.config.override_config();
+        let (_,_,identity,_)=validator.get_key_objects(None)?;
+        println!("{} {} {} {}", validator.index, validator.dir.join("node.yaml").display(), config.api.address, identity.account_address);
+    }
+    Ok(())
+}
