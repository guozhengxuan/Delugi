+// Application observation only; native ordering/validation remain unchanged.
+use crate::{
+    chain_id::ChainId,
+    transaction::{
+        authenticator::AuthenticationKey, RawTransaction, Script, SignedTransaction,
+        TransactionPayload,
+    },
+};
+use aptos_crypto::{ed25519::Ed25519PrivateKey, PrivateKey, Uniform};
+use rand::rngs::OsRng;
+use serde_json::json;
+use std::{
+    collections::HashSet,
+    fs::{File, OpenOptions},
+    io::Write,
+    path::Path,
+    sync::{Mutex, OnceLock},
+};
+
+fn monotonic_us() -> u64 {
+    delugi_benchmark_observer::fault::monotonic_ns() / 1000
+}
+pub fn write_workload(
+    path: &Path,
+    run: &str,
+    origin: u64,
+    count: u64,
+    useful_bytes: usize,
+) -> anyhow::Result<()> {
+    let run_bytes = hex::decode(run)?;
+    anyhow::ensure!(run_bytes.len() == 16, "expected 16-byte run ID");
+    // The finite manifest contains signed requests, never the private key.
+    // A public run ID must not determine an impersonatable signing key.
+    let mut rng = OsRng;
+    let key = Ed25519PrivateKey::generate(&mut rng);
+    let public = key.public_key();
+    let sender = AuthenticationKey::ed25519(&public).account_address();
+    let expiration = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)?
+        .as_secs()
+        + 3600;
+    let mut file = OpenOptions::new().write(true).create_new(true).open(path)?;
+    for sequence in 0..count {
+        let mut code = b"DLGCOH02".to_vec();
+        code.extend_from_slice(&run_bytes);
+        code.extend_from_slice(&origin.to_le_bytes());
+        code.extend_from_slice(&sequence.to_le_bytes());
+        code.extend_from_slice(&(useful_bytes as u64).to_le_bytes());
+        code.extend(
+            (0..useful_bytes).map(|index| ((origin + sequence + index as u64) % 251) as u8),
+        );
+        let transaction = RawTransaction::new_script(
+            sender,
+            sequence,
+            Script::new(code, vec![], vec![]),
+            1_000_000,
+            1,
+            expiration,
+            ChainId::test(),
+        )
+        .sign(&key, public.clone())?
+        .into_inner();
+        let serialized = bcs::to_bytes(&transaction)?;
+        writeln!(
+            file,
+            "{}",
+            json!({"request_id":transaction.clone().committed_hash().to_hex(),"run_id":run,"origin":origin,"sequence":sequence,"useful_bytes":useful_bytes,"serialized_bytes":serialized.len(),"bcs_hex":hex::encode(serialized)})
+        )?;
+    }
+    Ok(())
+}
+
+#[derive(serde::Deserialize)]
+struct Plan {
+    schema: u64,
+    run_id: String,
+    counts: Vec<usize>,
+    useful_bytes: u64,
+    identities: Vec<Vec<String>>,
+}
+struct Observer {
+    file: Option<File>,
+    checkpoints: File,
+    receipt_dir: std::path::PathBuf,
+    control: std::path::PathBuf,
+    run: Vec<u8>,
+    run_id: String,
+    plan_hash: String,
+    useful_bytes: u64,
+    mode: String,
+    state: crate::benchmark_receipt::Receipt,
+    admission: delugi_benchmark_observer::admission::Admission,
+    batches: HashSet<String>,
+    batch_count: u64,
+    payload_bytes: u64,
+    digest: [u8; 32],
+    frozen: bool,
+}
+static OBSERVER: OnceLock<Option<Mutex<Observer>>> = OnceLock::new();
+fn hash(bytes: &[u8]) -> [u8; 32] {
+    aptos_crypto::HashValue::sha3_256_of(bytes)
+        .to_vec()
+        .try_into()
+        .unwrap()
+}
+fn atomic_json(path: &Path, value: &serde_json::Value) {
+    let temporary = path.with_extension("tmp");
+    std::fs::write(&temporary, format!("{}\n", value)).unwrap();
+    std::fs::rename(temporary, path).unwrap();
+}
+fn observer() -> Option<&'static Mutex<Observer>> {
+    OBSERVER.get_or_init(|| {
+        let path=std::path::PathBuf::from(std::env::var_os("BENCHMARK_COHORT_PATH")?);
+        let run_id=std::env::var("BENCHMARK_RUN_ID").expect("benchmark run ID");
+        let run=hex::decode(&run_id).expect("hex run ID");assert_eq!(run.len(),16);
+        let mode=std::env::var("BENCHMARK_OBSERVER_MODE").unwrap_or_else(|_|"full".into());
+        assert!(mode=="full" || mode=="compact");
+        let plan_raw=std::fs::read(std::env::var_os("BENCHMARK_FINITE_PLAN").expect("finite plan")).unwrap();
+        let plan:Plan=serde_json::from_slice(&plan_raw).expect("finite signed plan");
+        assert_eq!(plan.schema,1);assert_eq!(plan.run_id,run_id);assert!(plan.useful_bytes>0);
+        let origin:usize=std::env::var("BENCHMARK_ORIGIN").expect("origin").parse().unwrap();
+        assert_eq!(plan.counts.len(),plan.identities.len());
+        let identities:Vec<Vec<[u8;32]>>=plan.identities.into_iter().enumerate().map(|(i,rows)|{
+            assert_eq!(rows.len(),plan.counts[i]);rows.into_iter().map(|id|hex::decode(id).unwrap().try_into().unwrap()).collect()
+        }).collect();
+        let state=crate::benchmark_receipt::Receipt::new(identities,origin);
+        let plan_digest=hash(&plan_raw);let mut header=b"DLGSHAD1".to_vec();header.extend_from_slice(&run);
+        header.extend_from_slice(&(origin as u64).to_le_bytes());header.extend_from_slice(&(state.counts[origin]as u64).to_le_bytes());header.extend_from_slice(&plan_digest);
+        let admission=delugi_benchmark_observer::admission::Admission::open(Path::new(&std::env::var_os("BENCHMARK_ADMISSION_PATH").expect("admission path")),&header,state.counts[origin]).unwrap();
+        let receipt_dir=std::path::PathBuf::from(std::env::var_os("BENCHMARK_RECEIPT_DIR").expect("receipt directory"));
+        std::fs::create_dir(&receipt_dir).expect("new receipt directory");
+        let checkpoints=OpenOptions::new().create_new(true).write(true).open(receipt_dir.join("checkpoints.jsonl")).unwrap();
+        let control=std::path::PathBuf::from(std::env::var_os("BENCHMARK_FREEZE_PATH").expect("freeze path"));
+        let file=if mode=="full"{Some(OpenOptions::new().create_new(true).write(true).open(path).expect("create native output ledger"))}else{None};
+        let observer=Observer{file,checkpoints,receipt_dir,control,run,run_id,plan_hash:hex::encode(plan_digest),useful_bytes:plan.useful_bytes,mode,state,admission,batches:HashSet::new(),batch_count:0,payload_bytes:0,digest:hash(b"Shoal-native-prefix-v1"),frozen:false};
+        std::thread::Builder::new().name("shoal-receipt".into()).spawn(||loop {
+            std::thread::sleep(std::time::Duration::from_millis(20));
+            let Some(mutex)=self::observer() else{return};let mut observer=mutex.lock().unwrap();
+            if observer.frozen{return}
+            let now=monotonic_us();
+            atomic_json(&observer.receipt_dir.join("counters.json"),&json!({"schema":1,"format":"shoal-native-counters-v1","run_id":observer.run_id,"plan_sha3_256":observer.plan_hash,"origin":observer.state.origin,"mode":observer.mode,"observed_us":now,"output_count":observer.state.output_count,"own_eligible_count":observer.state.own_eligible_count,"payload_bytes":observer.payload_bytes,"batch_count":observer.batch_count}));
+            if let Ok(raw)=std::fs::read(&observer.control) {
+                let request:serde_json::Value=serde_json::from_slice(&raw).expect("freeze request");
+                assert_eq!(request["run_id"].as_str(),Some(observer.run_id.as_str()));
+                let requested=request["requested_us"].as_u64().expect("requested freeze time");
+                if now<requested{continue}
+                observer.frozen=true;
+                let mut descriptors=vec![];
+                for (name,origin,bits) in observer.state.materialized.iter().enumerate().map(|(origin,bits)|("materialized",origin,bits))
+                    .chain([("own_seen",observer.state.origin,&observer.state.own_seen),("own_eligible",observer.state.origin,&observer.state.own_eligible)]) {
+                    let path=format!("{}-{}.bits",name,origin);std::fs::write(observer.receipt_dir.join(&path),bits).unwrap();
+                    descriptors.push(json!({"name":name,"origin":origin,"path":path,"bytes":bits.len(),"sha3_256":hex::encode(hash(bits)),"ones":bits.iter().map(|byte|byte.count_ones()as u64).sum::<u64>()}));
+                }
+                atomic_json(&observer.receipt_dir.join("header.json"),&json!({"schema":1,"format":"shoal-native-receipt-v1","run_id":observer.run_id,"plan_sha3_256":observer.plan_hash,"origin":observer.state.origin,"counts":observer.state.counts,"useful_bytes":observer.useful_bytes,"mode":observer.mode,"requested_us":requested,"frozen_us":now,"output_count":observer.state.output_count,"batch_count":observer.batch_count,"payload_bytes":observer.payload_bytes,"prefix_sha3_256":hex::encode(observer.digest),"streams":descriptors}));
+                return
+            }
+        }).expect("native receipt control");
+        Some(Mutex::new(observer))
+    }).as_ref()
+}
+pub fn enabled() -> bool {
+    observer().is_some()
+}
+pub fn ordered_batch(batch_id: String, transactions: &[SignedTransaction]) {
+    let Some(mutex) = observer() else { return };
+    let mut observer = loop {
+        let guard = mutex.lock().unwrap();
+        if !guard.frozen {
+            break guard;
+        }
+        drop(guard);
+        std::thread::sleep(std::time::Duration::from_millis(20));
+    };
+    let bytes: usize = transactions
+        .iter()
+        .map(|transaction| bcs::serialized_size(transaction).unwrap())
+        .sum();
+    let unique = observer.batches.insert(batch_id.clone());
+    if unique { observer.payload_bytes += bytes as u64; }
+    let first_index = observer.state.output_count;
+    let batch_index = observer.batch_count;
+    if let Some(file) = observer.file.as_mut() {
+        writeln!(file,"{}",json!({"event":"batch","batch_index":batch_index,"first_index":first_index,"unique_batch":unique,"exact_batch_id":batch_id,"payload_bytes":bytes,"materialized_us":monotonic_us()})).unwrap();
+    }
+    let mut boundary = b"B".to_vec();
+    boundary.extend_from_slice(&observer.digest);
+    boundary.extend_from_slice(&hash(batch_id.as_bytes()));
+    boundary.extend_from_slice(&(bytes as u64).to_le_bytes());
+    boundary.extend_from_slice(&first_index.to_le_bytes());
+    observer.digest = hash(&boundary);
+    for transaction in transactions {
+        let identity = (|| {
+            let code = match transaction.payload() {
+                TransactionPayload::Script(script) => script.code(),
+                _ => return None,
+            };
+            if code.len() < 48 || &code[..8] != b"DLGCOH02" || code[8..24] != observer.run[..] {
+                return None;
+            }
+            let origin = u64::from_le_bytes(code[24..32].try_into().ok()?);
+            let sequence = u64::from_le_bytes(code[32..40].try_into().ok()?);
+            let useful = u64::from_le_bytes(code[40..48].try_into().ok()?);
+            if useful != u64::try_from(code.len() - 48).ok()? || useful != observer.useful_bytes {
+                return None;
+            }
+            if !code[48..].iter().enumerate().all(|(i, byte)| {
+                *byte == (origin.wrapping_add(sequence).wrapping_add(i as u64) % 251) as u8
+            }) {
+                return None;
+            }
+            if transaction.clone().check_signature().is_err() {
+                return None;
+            }
+            Some((origin, sequence, useful))
+        })();
+        let id: [u8; 32] = transaction
+            .clone()
+            .committed_hash()
+            .to_vec()
+            .try_into()
+            .unwrap();
+        let index = observer.state.output_count;
+        let mut row = b"T".to_vec();
+        row.extend_from_slice(&observer.digest);
+        row.extend_from_slice(&index.to_le_bytes());
+        row.extend_from_slice(&id);
+        observer.digest = hash(&row);
+        let eligible = {
+            let Observer {
+                state, admission, ..
+            } = &mut *observer;
+            state.output(
+                &id,
+                identity.map(|(origin, sequence, _)| (origin as usize, sequence as usize)),
+                |sequence| admission.contains(sequence),
+            )
+        };
+        if let Some(file) = observer.file.as_mut() {
+            let row = if let Some((origin, sequence, useful)) = identity {
+                json!({"event":"output","request_id":hex::encode(id),"origin":origin,"sequence":sequence,"useful_bytes":useful,"output_index":index,"exact_batch_id":batch_id,"materialized_us":monotonic_us(),"origin_eligible":eligible})
+            } else {
+                json!({"event":"uncredited_output","request_id":hex::encode(id),"origin":-1,"sequence":0,"useful_bytes":0,"output_index":index,"exact_batch_id":batch_id,"materialized_us":monotonic_us(),"origin_eligible":false})
+            };
+            writeln!(file, "{}", row).unwrap();
+        }
+    }
+    let checkpoint = json!({"batch_index":observer.batch_count,"exact_batch_id":batch_id,"payload_bytes":bytes,"unique_batch":unique,"first_index":first_index,"output_count":observer.state.output_count,"prefix_sha3_256":hex::encode(observer.digest)});
+    writeln!(observer.checkpoints, "{}", checkpoint).unwrap();
+    observer.batch_count += 1;
+}
diff --git a/types/src/benchmark_receipt.rs b/types/src/benchmark_receipt.rs
new file mode 100644
index 0000000..e4fa3ef
--- /dev/null
+++ b/types/src/benchmark_receipt.rs
@@ -0,0 +1,114 @@
+// Pure finite identity state shared by full and compact application observation.
+// No clocks, JSON, filesystem IO, or protocol types occur in the per-output path.
+use std::collections::HashMap;
+pub(crate) type Identity = [u8; 32];
+pub(crate) struct Receipt {
+    pub counts: Vec<usize>,
+    pub origin: usize,
+    pub output_count: u64,
+    pub own_eligible_count: u64,
+    pub materialized: Vec<Vec<u8>>,
+    pub own_seen: Vec<u8>,
+    pub own_eligible: Vec<u8>,
+    identities: HashMap<Identity, (usize, usize)>,
+}
+impl Receipt {
+    pub fn new(identities: Vec<Vec<Identity>>, origin: usize) -> Self {
+        assert!(origin < identities.len() && identities.len() <= 31);
+        let counts: Vec<_> = identities.iter().map(Vec::len).collect();
+        assert!(
+            counts.iter().sum::<usize>() <= 5_000_000,
+            "finite observer population limit"
+        );
+        let mut lookup = HashMap::new();
+        for (who, rows) in identities.into_iter().enumerate() {
+            for (sequence, id) in rows.into_iter().enumerate() {
+                assert!(
+                    lookup.insert(id, (who, sequence)).is_none(),
+                    "duplicate finite signed identity"
+                );
+            }
+        }
+        let materialized = counts
+            .iter()
+            .map(|count| vec![0; (count + 7) / 8])
+            .collect();
+        let own_seen = vec![0; (counts[origin] + 7) / 8];
+        let own_eligible = own_seen.clone();
+        Self {
+            counts,
+            origin,
+            output_count: 0,
+            own_eligible_count: 0,
+            materialized,
+            own_seen,
+            own_eligible,
+            identities: lookup,
+        }
+    }
+
+    pub fn output(
+        &mut self,
+        id: &Identity,
+        valid: Option<(usize, usize)>,
+        admitted: impl FnOnce(usize) -> bool,
+    ) -> bool {
+        self.output_count += 1;
+        let Some(&(origin, sequence)) = self.identities.get(id) else {
+            return false;
+        };
+        if valid != Some((origin, sequence)) {
+            return false;
+        }
+        self.materialized[origin][sequence / 8] |= 1 << (sequence % 8);
+        if origin != self.origin {
+            return true;
+        }
+        let mask = 1 << (sequence % 8);
+        if self.own_seen[sequence / 8] & mask == 0 {
+            self.own_seen[sequence / 8] |= mask;
+            if admitted(sequence) {
+                self.own_eligible[sequence / 8] |= mask;
+                self.own_eligible_count += 1;
+            }
+        }
+        self.own_eligible[sequence / 8] & mask != 0
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn first_output_latches_admission_and_never_retroactively_credits() {
+        let mut state = Receipt::new(vec![vec![[1; 32], [2; 32]], vec![[3; 32]]], 0);
+        assert!(!state.output(&[1; 32], Some((0, 0)), |_| false));
+        assert!(!state.output(&[1; 32], Some((0, 0)), |_| true));
+        assert!(state.output(&[2; 32], Some((0, 1)), |_| true));
+        assert!(state.output(&[3; 32], Some((1, 0)), |_| panic!("remote clock read")));
+        assert_eq!(state.own_seen, vec![3]);
+        assert_eq!(state.own_eligible, vec![2]);
+        assert_eq!(state.materialized, vec![vec![3], vec![1]]);
+        assert_eq!(state.output_count, 4);
+    }
+    #[test]
+    fn malformed_unknown_and_wrong_origin_preserve_ordinals_without_credit() {
+        let mut state = Receipt::new(vec![vec![[1; 32]]], 0);
+        for (id, identity) in [
+            ([1; 32], None),
+            ([1; 32], Some((1, 0))),
+            ([2; 32], Some((0, 0))),
+        ] {
+            assert!(!state.output(&id, identity, |_| panic!("unknown admission lookup")));
+        }
+        assert_eq!(state.output_count, 3);
+        assert_eq!(state.materialized, vec![vec![0]]);
+    }
+    #[test]
+    fn empty_population_retains_unknown_native_output() {
+        let mut state = Receipt::new(vec![vec![]], 0);
+        assert!(!state.output(&[1; 32], None, |_| false));
+        assert_eq!(state.output_count, 1);
+        assert!(state.materialized[0].is_empty());
+    }
+}
