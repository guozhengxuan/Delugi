+// Optional benchmark-client ingress batching; native consensus/Quorum Store
+// batching is unchanged. A zero cadence preserves one transaction per request.
+fn matched_ingress_shape(rate_per_origin: u64, batch_ms: u64) -> (usize, u64) {
+    assert!(rate_per_origin > 0);
+    if batch_ms == 0 { return (1, rate_per_origin); }
+    assert!(batch_ms <= 1000 && 1000 % batch_ms == 0, "ingress interval must divide one second");
+    assert_eq!((rate_per_origin * batch_ms) % 1000, 0, "ingress batch must contain an integral transaction count");
+    let batch_size = rate_per_origin * batch_ms / 1000;
+    assert!(batch_size > 0);
+    let slots = 1000 / batch_ms;
+    assert_eq!(batch_size * slots, rate_per_origin);
+    (batch_size as usize, slots)
+}
