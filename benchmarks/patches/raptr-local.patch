+// Only exposes the pinned Raptr bound; native timer multipliers and QS batching remain unchanged.
+mod raptr_delta_configuration {
+    pub(super) fn parse_ms(value: Option<&str>) -> Result<u64, &'static str> {
+        let millis = value.map_or(Ok(200), |value| value.parse::<u64>()
+            .map_err(|_| "RAPTR_DELTA_MS must be an integer"))?;
+        if !(1..=60_000).contains(&millis) {
+            return Err("RAPTR_DELTA_MS must be between 1 and 60000 milliseconds");
+        }
+        Ok(millis)
+    }
+
+    #[cfg(test)]
+    mod tests {
+        #[test]
+        fn preserves_native_default_and_accepts_selected_bound() {
+            assert_eq!(super::parse_ms(None), Ok(200));
+            assert_eq!(super::parse_ms(Some("100")), Ok(100));
+            assert_eq!(super::parse_ms(Some("60000")), Ok(60_000));
+        }
+
+        #[test]
+        fn rejects_invalid_and_out_of_range_bounds() {
+            for value in ["0", "-1", "60001", "NaN", "0.1", "", "18446744073709551616"] {
+                assert!(super::parse_ms(Some(value)).is_err(), "{}", value);
+            }
+        }
+    }
+}
+// END DELUGI_BASELINE_TIMING_CONFIG
