+/// Opaque padding for the native consensus-only workload; no Move VM execution.
+/// Keep native sender/sequence identifiers and authenticator while matching a
+/// requested serialized transaction size across implementations.
+fn sized_consensus_transaction(sender: PeerId, sequence: u64, target_bytes: usize) -> SignedTransaction {
+    let make = |padding: usize| {
+        let TransactionPayload::EntryFunction(entry) = aptos_coin_transfer(sender, 100) else {
+            unreachable!()
+        };
+        let mut args = entry.args().to_vec();
+        args.push(vec![0; padding]);
+        let payload = TransactionPayload::EntryFunction(EntryFunction::new(
+            entry.module().clone(), entry.function().to_owned(), entry.ty_args().to_vec(), args,
+        ));
+        SignedTransaction::new_single_sender(
+            RawTransaction::new(sender, sequence, payload, 0, 0, 60, ChainId::test()),
+            AccountAuthenticator::NoAccountAuthenticator,
+        )
+    };
+    let overhead = bcs::to_bytes(&make(0)).unwrap().len();
+    assert!(target_bytes >= overhead, "requested transaction is smaller than native metadata");
+    // BCS vector-length prefixes grow at 128-byte boundaries. The first estimate
+    // is at most a few bytes too large; find and assert the exact serialized size.
+    let mut padding = target_bytes - overhead;
+    loop {
+        let txn = make(padding);
+        let observed = bcs::to_bytes(&txn).unwrap().len();
+        if observed == target_bytes { return txn; }
+        assert!(observed > target_bytes && padding > 0, "requested BCS size is not representable");
+        padding -= 1;
+    }
+}
