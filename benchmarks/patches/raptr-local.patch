+#[test]
+fn test_matched_consensus_transaction_size() {
+    let sender = PeerId::random();
+    for size in [256, 512, 1024] {
+        for sequence in [0, 127, 128, u64::MAX] {
+            let txn = sized_consensus_transaction(sender, sequence, size);
+            assert_eq!(bcs::to_bytes(&txn).unwrap().len(), size);
+            assert_eq!(txn.sender(), sender);
+            assert_eq!(txn.sequence_number(), sequence);
+            let round_trip: SignedTransaction = bcs::from_bytes(&bcs::to_bytes(&txn).unwrap()).unwrap();
+            assert_eq!(txn, round_trip);
+        }
+    }
+}
+
+#[test]
+fn test_matched_consensus_ingress_shape() {
+    assert_eq!(matched_ingress_shape(250, 0), (1, 250));
+    assert_eq!(matched_ingress_shape(250, 100), (25, 10));
+    assert_eq!(matched_ingress_shape(1000, 100), (100, 10));
+}
