+        if let Some(dir)=dir { METRICS.call_once(|| {let dir=dir.clone();std::thread::Builder::new().name("observer-io".into()).spawn(move||loop{
+            let row=format!(r#"{{"observed_us":{},"written_bytes":{},"read_bytes":{},"window_written_bytes":{},"window_read_bytes":{}}}"#,now_us(),WRITTEN.load(Ordering::Relaxed),READ.load(Ordering::Relaxed),WINDOW_WRITTEN.load(Ordering::Relaxed),WINDOW_READ.load(Ordering::Relaxed));
+            fs::write(dir.join("io.tmp"),row).expect("observer IO write");fs::rename(dir.join("io.tmp"),dir.join("io.json")).expect("observer IO publish");
+            std::thread::sleep(std::time::Duration::from_millis(10));
+        }).expect("observer IO thread");}); }
+        dir
+    }
+    pub fn enabled()->bool {directory().is_some()}
+    pub fn hex(bytes:&[u8])->String {bytes.iter().map(|b|format!("{b:02x}")).collect()}
+    fn append(name:&str,row:String){let _guard=EVENT_LOCK.lock().unwrap();if let Some(dir)=directory(){let mut file=OpenOptions::new().create(true).append(true).open(dir.join(name)).expect("observer event file");writeln!(file,"{row}").expect("observer event write");}}
+    pub fn available(digest:&[u8],payload:&[u8]) {
+        if let Some(dir)=directory() {let _guard=PAYLOAD_LOCK.lock().unwrap();let digest=hex(digest);let time=now_us();
+            if dir.join(format!("batch-{digest}.bin")).exists(){return;}
+            fs::write(dir.join(format!("batch-{digest}.tmp")),payload).expect("observer payload write");
+            fs::rename(dir.join(format!("batch-{digest}.tmp")),dir.join(format!("batch-{digest}.bin"))).expect("observer payload publish");
+            append("available.jsonl",format!(r#"{{"digest":"{digest}","available_us":{time}}}"#));
+        }
+    }
+    pub fn slot_header(slot:u64,id:&[u8],parent:&[u8],author:&[u8],height:u64,batches:Vec<String>){if enabled(){append("slots.jsonl",format!(r#"{{"event":"header","slot":{slot},"height":{height},"author":"{}","header_id":"{}","parent_id":"{}","ordered_us":{},"batches":[{}]}}"#,hex(author),hex(id),hex(parent),now_us(),batches.iter().map(|s|format!("\"{s}\"")).collect::<Vec<_>>().join(",")));}}
+    pub fn complete_slot(slot:u64){if enabled(){append("slots.jsonl",format!(r#"{{"event":"complete","slot":{slot},"ordered_us":{}}}"#,now_us()));}}
+    fn count(n:usize,write:bool){let (total,window)=if write{(&WRITTEN,&WINDOW_WRITTEN)}else{(&READ,&WINDOW_READ)};total.fetch_add(n as u64,Ordering::Relaxed);
+        if enabled(){let now=now_us();let start=parameter("BENCHMARK_WARMUP_US");if now>0 && now>=start && now<start+parameter("BENCHMARK_DURATION_US"){window.fetch_add(n as u64,Ordering::Relaxed);}}
+    }
+    pub struct CountedStream(pub TcpStream);
+    impl AsyncRead for CountedStream {fn poll_read(mut self:Pin<&mut Self>,cx:&mut Context<'_>,buf:&mut ReadBuf<'_>)->Poll<io::Result<()>> {let before=buf.filled().len();let result=Pin::new(&mut self.0).poll_read(cx,buf);if let Poll::Ready(Ok(()))=&result{count(buf.filled().len()-before,false);}result}}
+    impl AsyncWrite for CountedStream {
+        fn poll_write(mut self:Pin<&mut Self>,cx:&mut Context<'_>,buf:&[u8])->Poll<io::Result<usize>>{let result=Pin::new(&mut self.0).poll_write(cx,buf);if let Poll::Ready(Ok(n))=&result{count(*n,true);}result}
+        fn poll_write_vectored(mut self:Pin<&mut Self>,cx:&mut Context<'_>,bufs:&[io::IoSlice<'_>])->Poll<io::Result<usize>>{let result=Pin::new(&mut self.0).poll_write_vectored(cx,bufs);if let Poll::Ready(Ok(n))=&result{count(*n,true);}result}
+        fn is_write_vectored(&self)->bool{self.0.is_write_vectored()}
+        fn poll_flush(mut self:Pin<&mut Self>,cx:&mut Context<'_>)->Poll<io::Result<()>>{Pin::new(&mut self.0).poll_flush(cx)}
