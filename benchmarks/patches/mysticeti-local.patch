+// Counts completed socket operations, including partial progress before a later failure.
+// This wrapper is used only for replica streams; metrics HTTP traffic is excluded.
+struct MeteredStream<T> {
+    inner: T,
+    written: prometheus::IntCounter,
+    read: prometheus::IntCounter,
+}
+
+impl<T> MeteredStream<T> {
+    fn new(inner: T, metrics: &Metrics) -> Self {
+        Self {
+            inner,
+            written: metrics.benchmark_tcp_written_bytes.clone(),
+            read: metrics.benchmark_tcp_read_bytes.clone(),
+        }
+    }
+}
+
+impl<T: AsyncRead + Unpin> AsyncRead for MeteredStream<T> {
+    fn poll_read(
+        self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        buf: &mut ReadBuf<'_>,
+    ) -> Poll<io::Result<()>> {
+        let this = self.get_mut();
+        let before = buf.filled().len();
+        let result = Pin::new(&mut this.inner).poll_read(cx, buf);
+        this.read.inc_by((buf.filled().len() - before) as u64);
+        result
+    }
+}
+
+impl<T: AsyncWrite + Unpin> AsyncWrite for MeteredStream<T> {
+    fn poll_write(
+        self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        buf: &[u8],
+    ) -> Poll<io::Result<usize>> {
+        let this = self.get_mut();
+        let result = Pin::new(&mut this.inner).poll_write(cx, buf);
+        if let Poll::Ready(Ok(count)) = &result {
+            this.written.inc_by(*count as u64);
+        }
+        result
+    }
+    fn poll_flush(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.get_mut().inner).poll_flush(cx)
+    }
+    fn poll_shutdown(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.get_mut().inner).poll_shutdown(cx)
+    }
+}
+
