+            3,
+            notify.clone(),
+            commit_handler,
+            metrics.clone(),
+        ));
+        let (stop, stop_receiver) = mpsc::channel(1);
+        stop.try_send(()).unwrap();
+        let (epoch_close_signal, epoch_receiver) = mpsc::channel(1);
+        epoch_close_signal.try_send(()).unwrap();
+        let inner = Arc::new(NetworkSyncerInner {
+            syncer,
+            block_store,
+            notify,
+            committee,
+            stop,
+            epoch_close_signal,
+            epoch_closing_time,
+        });
+        let mut timer = Box::pin(NetworkSyncer::leader_timeout_task(
+            inner.clone(),
+            epoch_receiver,
+            Duration::from_secs(2),
+            parameters.leader_timeout,
+        ));
+        assert!(poll!(&mut timer).is_pending());
+        tokio::time::advance(Duration::from_millis(50)).await;
+        inner.notify.notify_waiters();
+        assert!(poll!(&mut timer).is_pending());
+        tokio::time::advance(Duration::from_millis(99)).await;
+        assert!(poll!(&mut timer).is_pending());
+        assert_eq!(metrics.leader_timeout_total.get(), 0);
+        tokio::time::advance(Duration::from_millis(1)).await;
+        assert!(poll!(&mut timer).is_pending());
+        // FIFO core commands: the barrier returns after the timeout was handled.
+        inner.syncer.authority_connection(0, false).await;
+        assert_eq!(metrics.leader_timeout_total.get(), 1);
+        assert!(poll!(&mut timer).is_pending());
+
+        drop(stop_receiver);
+        assert!(poll!(&mut timer).is_ready());
+        drop(timer);
+        let inner = Arc::try_unwrap(inner).unwrap_or_else(|_| panic!("timer retained inner"));
+        inner.syncer.stop();
+    }
