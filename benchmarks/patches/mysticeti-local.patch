+                    let mode = std::env::var("BENCHMARK_COHORT_OBSERVER")
+                        .unwrap_or_else(|_| "full".into());
+                    assert!(mode == "full" || mode == "compact");
+                    let receipt = std::env::var_os("BENCHMARK_RECEIPT_DIR").map(|directory| {
+                        let counts = std::env::var("BENCHMARK_RECEIPT_COUNTS")
+                            .expect("finite native counts")
+                            .split(',')
+                            .map(|x| x.parse().expect("finite native count"))
+                            .collect();
+                        ReceiptState::new(
+                            counts,
+                            setting("BENCHMARK_RECEIPT_ORIGIN", u64::MAX) as usize,
+                            setting("BENCHMARK_RECEIPT_USEFUL_BYTES", 0) as usize,
+                            directory.into(),
+                        )
+                    });
+                    assert!(
+                        mode == "full" || receipt.is_some(),
+                        "compact requires finite receipts"
+                    );
+                    Journal {
+                        epoch: Instant::now(),
+                        detailed: mode == "full",
+                        shared: Mutex::new(Shared {
+                            writer: BufWriter::new(
+                                File::create(path).expect("create cohort journal"),
+                            ),
+                            receipt,
+                            frozen: false,
+                        }),
+                    }
+                })
+            })
+            .as_ref()
+    }
+    pub fn now_us() -> u64 {
+        journal()
+            .map(|j| j.epoch.elapsed().as_micros() as u64)
