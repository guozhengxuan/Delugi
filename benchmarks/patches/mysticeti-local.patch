+            .name("native-receipt-export".into())
+            .spawn(move || {
+                while !std::path::Path::new(&request).exists() {
+                    if let Some(j) = journal() {
+                        let mut shared = j.shared.lock().unwrap();
+                        if let Some(r) = shared.receipt.as_mut() {
+                            if let Some((a, b)) = r.window {
+                                let at = j.epoch.elapsed().as_micros() as u64;
+                                if r.process_window.len() < 2
+                                    && at >= if r.process_window.is_empty() { a } else { b }
