+            let mut shared = j.shared.lock().unwrap();
+            if let Some(receipt) = shared.receipt.as_mut() {
+                assert_eq!(receipt.origin, origin as usize);
+                assert_eq!(receipt.counts[origin as usize], count);
+                assert_eq!(receipt.useful, useful);
+                receipt.window = Some((start + warmup, start + warmup + duration));
+            }
+        }
+        emit(format!(
+            r#"{{"event":"start","origin":{origin},"elapsed_us":{start},"window_start_us":{},"window_end_us":{},"observed_us":{},"rate":{rate},"count":{count},"useful_bytes":{useful}}}"#,
+            start + warmup,
+            start + warmup + duration,
+            start + warmup + duration + drain
+        ));
+        flush();
+        let deadline = start + warmup + duration + drain;
+        let mut sequence = 0;
+        while sequence < count && now_us() < deadline {
+            let scheduled = start + (sequence as u128 * 1_000_000 / rate as u128) as u64;
+            let flush_at = start + ((scheduled - start) / cadence + 1) * cadence;
+            let last = ((((flush_at - start) as u128 * rate as u128 + 999_999) / 1_000_000) as u64)
+                .min(count);
+            let mut block = Vec::new();
+            let mut bytes = 0;
+            while sequence < last {
+                let due = start + (sequence as u128 * 1_000_000 / rate as u128) as u64;
+                while now_us() < due {
+                    std::thread::sleep(Duration::from_micros(
+                        due.saturating_sub(now_us()).min(1000),
+                    ));
+                }
+                let mut payload = Vec::with_capacity(parameters.transaction_size);
+                payload.extend_from_slice(&(timestamp_utc().as_millis() as u64).to_le_bytes());
+                payload.extend_from_slice(b"DLGCOH01");
+                payload.extend_from_slice(&origin.to_le_bytes());
+                payload.extend_from_slice(&sequence.to_le_bytes());
+                payload.extend_from_slice(&(useful as u64).to_le_bytes());
+                payload.extend(
+                    (0..useful).map(|i| {
+                        (origin.wrapping_add(sequence).wrapping_add(i as u64) % 251) as u8
+                    }),
+                );
+                let tx = Transaction::new(payload);
+                stage("admitted", &tx);
+                block.push(tx);
+                bytes += parameters.transaction_size;
+                sequence += 1;
+                if bytes >= config.parameters.max_block_size || sequence == last {
+                    if sequence == last {
+                        while now_us() < flush_at {
+                            std::thread::sleep(Duration::from_micros(
+                                flush_at.saturating_sub(now_us()).min(1000),
+                            ));
+                        }
+                    }
+                    for tx in &block {
+                        stage("batch_ready", tx);
+                    }
+                    loop {
+                        if now_us() >= deadline {
+                            for tx in &block {
+                                stage("not_admitted", tx);
+                            }
+                            flush();
+                            return;
+                        }
+                        match sender.try_reserve() {
+                            Ok(permit) => {
+                                for tx in &block {
+                                    stage("native_enqueued", tx);
+                                }
+                                let n = block.len() as u64;
+                                metrics.benchmark_enqueued_transactions.inc_by(n);
+                                metrics
+                                    .benchmark_enqueued_transaction_bytes
+                                    .inc_by(bytes as u64);
+                                metrics
+                                    .benchmark_enqueued_encoded_transaction_bytes
+                                    .inc_by(bytes as u64 + 8 * n);
+                                permit.send(block);
+                                break;
+                            }
+                            Err(mpsc::error::TrySendError::Full(_)) => {
+                                std::thread::sleep(Duration::from_millis(1))
+                            }
+                            Err(mpsc::error::TrySendError::Closed(_)) => return,
+                        }
+                    }
+                    block = Vec::new();
+                    bytes = 0;
+                    flush();
+                }
+            }
+        }
+        emit(format!(
+            r#"{{"event":"arrivals_finished","elapsed_us":{}}}"#,
+            now_us()
+        ));
+        flush();
+    }
+    // Shared correctness receipt state. No native consensus/storage decisions use it.
+    const MAX_ORIGIN_COUNT: u64 = 5_000_000;
+    const PAGE: usize = 4096;
+    #[derive(Clone)]
+    struct Bits {
+        count: u64,
+        bytes: Vec<u8>,
+    }
+    impl Bits {
+        fn new(count: u64) -> Self {
+            assert!(count <= MAX_ORIGIN_COUNT);
+            Self {
+                count,
+                bytes: vec![0; (count as usize + 7) / 8],
+            }
+        }
+        fn get(&self, n: u64) -> bool {
+            n < self.count && self.bytes[n as usize / 8] & (1 << (n % 8)) != 0
+        }
+        fn set(&mut self, n: u64) -> bool {
+            assert!(n < self.count);
+            let was = self.get(n);
+            self.bytes[n as usize / 8] |= 1 << (n % 8);
+            !was
+        }
+        fn ones(&self) -> u64 {
+            self.bytes.iter().map(|b| b.count_ones() as u64).sum()
+        }
+    }
+    fn process_sample(at: u64) -> String {
+        let mut usage: libc::rusage = unsafe { std::mem::zeroed() };
+        assert_eq!(unsafe { libc::getrusage(libc::RUSAGE_SELF, &mut usage) }, 0);
+        let user = usage.ru_utime.tv_sec as u64 * 1_000_000 + usage.ru_utime.tv_usec as u64;
+        let system = usage.ru_stime.tv_sec as u64 * 1_000_000 + usage.ru_stime.tv_usec as u64;
+        let rss = usage.ru_maxrss as u64 * if cfg!(target_os = "macos") { 1 } else { 1024 };
+        format!("{{\"elapsed_us\":{at},\"user_cpu_us\":{user},\"system_cpu_us\":{system},\"peak_rss_bytes\":{rss}}}")
+    }
+    fn field(hash: &mut Blake2b512, bytes: &[u8]) {
+        hash.update((bytes.len() as u64).to_le_bytes());
+        hash.update(bytes);
+    }
+    fn hash_hex(hash: &Blake2b512) -> String {
+        hex::encode(hash.clone().finalize())
+    }
+    struct ReceiptState {
+        counts: Vec<u64>,
+        origin: usize,
+        useful: usize,
+        admitted: Bits,
+        ready: Bits,
+        eligible: Bits,
+        seen: Bits,
+        window_admitted: Bits,
+        window_completed: Bits,
+        materialized: Vec<Bits>,
+        outputs: u64,
+        batches: u64,
+        payload_bytes: u64,
+        output_hash: Blake2b512,
+        batch_hash: Blake2b512,
+        active: Option<(String, u64)>,
+        window: Option<(u64, u64)>,
+        requested_us: Option<u64>,
+        frozen_us: Option<u64>,
+        checkpoints: BufWriter<File>,
+        directory: std::path::PathBuf,
+        process_window: Vec<String>,
+    }
+    impl ReceiptState {
+        fn new(
+            counts: Vec<u64>,
+            origin: usize,
+            useful: usize,
+            directory: std::path::PathBuf,
+        ) -> Self {
+            assert!(!counts.is_empty() && counts.len() <= 31 && origin < counts.len());
+            assert!(counts.iter().all(|n| *n <= MAX_ORIGIN_COUNT));
+            std::fs::create_dir(&directory).expect("exclusive native receipt directory");
+            let checkpoints = BufWriter::new(
+                File::options()
+                    .write(true)
+                    .create_new(true)
+                    .open(directory.join("checkpoints.jsonl"))
+                    .expect("native receipt checkpoints"),
+            );
+            let own = counts[origin];
+            let materialized = counts.iter().map(|n| Bits::new(*n)).collect();
+            Self {
+                counts,
+                origin,
+                useful,
+                admitted: Bits::new(own),
+                ready: Bits::new(own),
+                eligible: Bits::new(own),
+                seen: Bits::new(own),
+                window_admitted: Bits::new(own),
+                window_completed: Bits::new(own),
+                materialized,
+                outputs: 0,
+                batches: 0,
+                payload_bytes: 0,
+                output_hash: Blake2b512::new(),
+                batch_hash: Blake2b512::new(),
+                active: None,
+                window: None,
+                requested_us: None,
+                frozen_us: None,
+                checkpoints,
+                directory,
+                process_window: Vec::new(),
+            }
+        }
+        fn in_window(&self, at: u64) -> bool {
+            self.window.map(|(a, b)| a <= at && at < b).unwrap_or(false)
+        }
+        fn stage(&mut self, event: &str, origin: u64, seq: u64, size: usize, at: u64) {
+            if self.frozen_us.is_some()
+                || origin as usize != self.origin
+                || size != self.useful
+                || seq >= self.counts[self.origin]
+            {
+                return;
+            }
+            if event == "admitted" {
+                if self.admitted.set(seq) && self.in_window(at) {
+                    self.window_admitted.set(seq);
+                }
+            } else if event == "batch_ready" {
+                assert!(self.admitted.get(seq));
+                self.ready.set(seq);
+            }
+        }
+        fn begin(&mut self, batch: &str, bytes: u64) {
+            if self.frozen_us.is_some() {
+                return;
+            }
+            assert!(self.active.is_none());
+            self.active = Some((batch.to_string(), bytes));
+        }
+        fn output(
+            &mut self,
+            raw: &[u8],
+            author: u64,
+            batch: &str,
+            index: u64,
+            identity: Option<&(u64, u64, usize, String)>,
+            at: u64,
+        ) {
+            if self.frozen_us.is_some() {
+                return;
+            }
+            assert_eq!(self.outputs, index);
+            assert_eq!(self.active.as_ref().unwrap().0, batch);
+            self.output_hash.update(b"mysticeti-native-output-v1\0");
+            self.output_hash.update(index.to_le_bytes());
+            self.output_hash.update(author.to_le_bytes());
+            // batch is full hex(bincode(BlockReference)), never a Display digest.
+            field(
+                &mut self.output_hash,
+                &hex::decode(batch).expect("full native block reference"),
+            );
+            field(&mut self.output_hash, raw);
+            self.outputs += 1;
+            if let Some((origin, seq, size, _)) = identity {
+                if *origin != author
+                    || *origin as usize >= self.counts.len()
+                    || *size != self.useful
+                    || *seq >= self.counts[*origin as usize]
+                {
+                    return;
+                }
+                self.materialized[*origin as usize].set(*seq);
+                if *origin as usize == self.origin && self.seen.set(*seq) && self.admitted.get(*seq)
+                {
+                    self.eligible.set(*seq);
+                    if self.in_window(at) {
+                        self.window_completed.set(*seq);
+                    }
+                }
+            }
+        }
+        fn end(&mut self, at: u64) {
+            if self.frozen_us.is_some() {
+                return;
+            }
+            let (batch, bytes) = self.active.take().expect("native receipt batch begin");
+            self.batch_hash.update(b"mysticeti-native-batch-v1\0");
+            self.batch_hash.update(self.batches.to_le_bytes());
+            field(
+                &mut self.batch_hash,
+                &hex::decode(&batch).expect("full native block reference"),
+            );
+            self.batch_hash.update(bytes.to_le_bytes());
+            self.batch_hash.update(self.outputs.to_le_bytes());
+            field(&mut self.batch_hash, &self.output_hash.clone().finalize());
+            self.batches += 1;
+            self.payload_bytes += bytes;
+            writeln!(self.checkpoints,"{{\"batch_count\":{},\"output_count\":{},\"payload_bytes\":{},\"output_hash\":\"{}\",\"batch_hash\":\"{}\"}}",self.batches,self.outputs,self.payload_bytes,hash_hex(&self.output_hash),hash_hex(&self.batch_hash)).expect("write native receipt checkpoint");
+            if self.requested_us.is_some() {
+                self.frozen_us = Some(at);
+            }
+        }
+        fn request(&mut self, at: u64) {
+            if self.requested_us.is_none() {
+                self.requested_us = Some(at);
+            }
+            if self.active.is_none() && self.frozen_us.is_none() {
+                self.frozen_us = Some(at);
+            }
+        }
+        fn export(&mut self, mode: &str) {
+            assert!(self.active.is_none() && self.frozen_us.is_some());
+            self.checkpoints
+                .flush()
+                .expect("flush native receipt checkpoints");
+            let mut descriptors = Vec::new();
+            for (name, origin, bits) in [
+                ("admitted", self.origin, &self.admitted),
+                ("ready", self.origin, &self.ready),
+                ("eligible", self.origin, &self.eligible),
+                ("seen", self.origin, &self.seen),
+                ("window_admitted", self.origin, &self.window_admitted),
+                ("window_completed", self.origin, &self.window_completed),
+            ]
+            .into_iter()
+            .chain(
+                self.materialized
+                    .iter()
+                    .enumerate()
+                    .map(|(origin, bits)| ("materialized", origin, bits)),
+            ) {
+                let path = format!("{name}-{origin}.bits");
+                let mut file = File::options()
+                    .write(true)
+                    .create_new(true)
+                    .open(self.directory.join(&path))
+                    .expect("exclusive bitmap");
+                let mut hash = Blake2b512::new();
+                for chunk in bits.bytes.chunks(PAGE) {
+                    file.write_all(chunk).expect("write bounded bitmap");
+                    hash.update(chunk);
+                }
+                descriptors.push(format!("{{\"name\":\"{name}\",\"origin\":{origin},\"path\":\"{path}\",\"count\":{},\"bytes\":{},\"ones\":{},\"hash\":\"{}\"}}",bits.count,bits.bytes.len(),bits.ones(),hash_hex(&hash)));
+            }
+            let mut checkpoint_file = File::open(self.directory.join("checkpoints.jsonl"))
+                .expect("read frozen checkpoints");
+            let mut checkpoint_hash = Blake2b512::new();
+            let mut checkpoint_bytes = 0u64;
+            let mut buffer = [0u8; PAGE];
+            loop {
+                let n = checkpoint_file
+                    .read(&mut buffer)
+                    .expect("read checkpoint chunk");
+                if n == 0 {
+                    break;
+                }
+                checkpoint_hash.update(&buffer[..n]);
+                checkpoint_bytes += n as u64;
+            }
+            let (a, b) = self.window.expect("native finite workload start");
+            let header=format!("{{\"schema\":1,\"format\":\"mysticeti-native-receipt-v1\",\"mode\":\"{mode}\",\"origin\":{},\"counts\":{:?},\"useful_bytes\":{},\"window_start_us\":{a},\"window_end_us\":{b},\"requested_us\":{},\"frozen_us\":{},\"output_count\":{},\"batch_count\":{},\"payload_bytes\":{},\"output_hash\":\"{}\",\"batch_hash\":\"{}\",\"process_window\":[{}],\"checkpoint_bytes\":{},\"checkpoint_hash\":\"{}\",\"streams\":[{}]}}\n",self.origin,self.counts,self.useful,self.requested_us.unwrap(),self.frozen_us.unwrap(),self.outputs,self.batches,self.payload_bytes,hash_hex(&self.output_hash),hash_hex(&self.batch_hash),self.process_window.join(","),checkpoint_bytes,hash_hex(&checkpoint_hash),descriptors.join(","));
+            assert!(header.len() <= 256 * 1024);
+            let tmp = self.directory.join("header.tmp");
+            let mut f = File::options()
+                .write(true)
+                .create_new(true)
+                .open(&tmp)
+                .expect("receipt header");
+            f.write_all(header.as_bytes())
+                .expect("write receipt header");
+            drop(f);
+            std::fs::rename(tmp, self.directory.join("header.json"))
+                .expect("publish complete native receipt");
+        }
+    }
+
+    #[cfg(test)]
+    mod receipt_tests {
+        use super::*;
+        fn state(root: &std::path::Path, name: &str) -> ReceiptState {
+            let mut value = ReceiptState::new(vec![3, 3], 0, 8, root.join(name));
+            value.window = Some((0, 100));
+            value
+        }
+        fn identity(origin: u64, seq: u64) -> (u64, u64, usize, String) {
+            (origin, seq, 8, format!("{origin}:{seq}"))
+        }
+        #[test]
+        fn full_and_compact_preserve_raw_prefix_preplay_and_independent_readiness() {
+            let root = tempfile::tempdir().unwrap();
+            let mut signatures = Vec::new();
+            for mode in ["full", "compact"] {
+                let mut r = state(root.path(), mode);
+                r.begin("abcd0001", 48);
+                r.output(b"preplay", 0, "abcd0001", 0, Some(&identity(0, 0)), 1);
+                r.stage("admitted", 0, 0, 8, 2);
+                r.output(b"same", 0, "abcd0001", 1, Some(&identity(0, 0)), 3);
+                r.stage("admitted", 0, 1, 8, 4);
+                r.output(b"before-ready", 0, "abcd0001", 2, Some(&identity(0, 1)), 5);
+                assert!(r.eligible.get(1));
+                assert!(!r.ready.get(1));
+                r.stage("batch_ready", 0, 1, 8, 6);
+                r.output(b"unknown", 0, "abcd0001", 3, None, 7);
+                r.output(b"foreign", 1, "abcd0001", 4, Some(&identity(0, 2)), 8);
+                assert!(!r.materialized[0].get(2));
+                assert!(!r.eligible.get(0));
+                r.end(9);
+                r.begin("abcd0002", 0);
+                r.end(10); // Empty native batch remains in receipt.
+                r.request(11);
+                r.export(mode);
+                signatures.push((
+                    r.outputs,
+                    r.batches,
+                    r.eligible.bytes.clone(),
+                    hash_hex(&r.output_hash),
+                    hash_hex(&r.batch_hash),
+                    std::fs::read(r.directory.join("checkpoints.jsonl")).unwrap(),
+                ));
+            }
+            assert_eq!(signatures[0], signatures[1]);
+            assert_eq!(signatures[0].0, 5);
+            assert_eq!(signatures[0].1, 2);
+        }
+        #[test]
+        fn complete_block_freeze_cannot_drop_unknown_tail_or_empty_batch() {
+            let root = tempfile::tempdir().unwrap();
+            let mut r = state(root.path(), "freeze");
+            r.begin("aabb0001", 5);
+            r.request(5);
+            assert!(r.frozen_us.is_none());
+            r.output(b"unknown", 1, "aabb0001", 0, None, 6);
+            r.end(7);
+            assert_eq!(r.frozen_us, Some(7));
+            assert_eq!(r.outputs, 1);
+            let hash = hash_hex(&r.output_hash);
+            r.begin("aabb0002", 1);
+            r.output(b"later-native-work", 0, "aabb0002", 1, None, 8);
+            r.end(9);
+            assert_eq!(hash, hash_hex(&r.output_hash));
+            assert_eq!(r.batches, 1);
+        }
+        #[test]
+        fn full_block_references_distinguish_display_prefix_collisions() {
+            let root = tempfile::tempdir().unwrap();
+            let mut a = state(root.path(), "a");
+            let mut b = state(root.path(), "b");
+            a.begin("112233440001", 0);
+            a.end(1);
+            b.begin("112233440002", 0);
+            b.end(1);
+            assert_ne!(hash_hex(&a.batch_hash), hash_hex(&b.batch_hash));
+            assert_eq!(hash_hex(&a.output_hash), hash_hex(&b.output_hash));
+        }
+    }
